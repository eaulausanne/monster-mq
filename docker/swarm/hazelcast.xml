<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hazelcast configuration for Docker Swarm deployment.

  Uses TCP/IP discovery with Docker Swarm DNS hostnames.
  Each MonsterMQ replica gets a hostname like "ark-node1-monstermq"
  via the {{.Node.Hostname}}-monstermq template in the compose file.

  Adjust the <member> entries to match your Swarm node hostnames.
-->
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
           http://www.hazelcast.com/schema/config/hazelcast-config-5.0.xsd">

    <cluster-name>MonsterMQ</cluster-name>

    <network>
        <port auto-increment="true" port-count="100">5701</port>
        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="true">
                <!-- Replace with your Swarm node hostnames appended with -monstermq -->
                <member>node1-monstermq:5701</member>
                <member>node2-monstermq:5701</member>
                <member>node3-monstermq:5701</member>
            </tcp-ip>
        </join>
    </network>

    <properties>
        <property name="hazelcast.heartbeat.interval.seconds">5</property>
        <property name="hazelcast.max.no.heartbeat.seconds">30</property>
        <property name="hazelcast.merge.first.run.delay.seconds">30</property>
        <property name="hazelcast.merge.next.run.delay.seconds">30</property>
    </properties>

</hazelcast>
